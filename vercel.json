{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/stress-test.js": {
      "includeFiles": "{stress-test.html,lifeplan-bridge.css,lifeplan-bridge.html}",
      "maxDuration": 10
    },
    "api/consultation.js": {
      "maxDuration": 10
    },
    "api/result-email.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/stress-test",
      "destination": "/api/stress-test"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
