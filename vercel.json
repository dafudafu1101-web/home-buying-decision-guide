{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/stress-test.js": {
      "includeFiles": "stress-test.html",
      "maxDuration": 10
    },
    "api/stress-test-save.js": {
      "includeFiles": "stress-test.html",
      "maxDuration": 10
    },
    "api/stress-test-save-v2.js": {
      "includeFiles": "stress-test.html",
      "maxDuration": 10
    },
    "api/stress-test-save-v3.js": {
      "includeFiles": "stress-test.html",
      "maxDuration": 10
    },
    "api/stress-test-save-v4.js": {
      "includeFiles": "stress-test.html",
      "maxDuration": 10
    },
    "api/result-pdf.js": {
      "maxDuration": 60
    },
    "api/consultation.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/stress-test",
      "destination": "/api/stress-test-save-v4"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}